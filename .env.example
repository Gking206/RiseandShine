# ============================================================
#  RISE AND SHINE — Variables d'environnement
#  Copiez ce fichier en ".env" (en local) ou saisissez ces
#  variables dans hPanel > Node.js > Variables d'environnement.
# ============================================================

NODE_ENV=production
PORT=3000

# Clé secrète des sessions : une longue chaîne aléatoire (au moins 32 caractères)
SESSION_SECRET=remplacez-par-une-longue-chaine-aleatoire

# Adresse publique du site (utilisée dans les e-mails)
APP_URL=https://votre-domaine.com

# ── Base de données MySQL (hPanel > Bases de données > MySQL) ──
# Sans DB_HOST, l'application utilise les fichiers JSON du dossier data/.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u123456789_riseandshine
DB_USER=u123456789_ras
DB_PASSWORD=mot-de-passe-de-la-base

# ── Envoi d'e-mails (SMTP) ──
# Boîte mail Hostinger : SMTP_HOST=smtp.hostinger.com, port 465, SMTP_SECURE=true
# Gmail : SMTP_HOST=smtp.gmail.com, port 465, et un « mot de passe d'application »
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contact@votre-domaine.com
SMTP_PASSWORD=mot-de-passe-de-la-boite-mail
MAIL_FROM=contact@votre-domaine.com

# Destinataire des demandes d'assistance des membres
SUPPORT_EMAIL=riseandshinebf@gmail.com

# Dossier des fichiers importés (photos, PDF, audio, vidéo).
# Par défaut : public/uploads. Sur un hébergement qui redéploie le dossier de
# l'application, indiquez un dossier extérieur, ex. /home/u123456789/ras-uploads
# UPLOADS_DIR=

# Premier compte Super Admin, créé UNIQUEMENT si la base ne contient encore
# aucun Super Admin (première installation). Sans ces variables, les deux
# comptes par défaut de config/appConfig.js sont créés.
# SUPERADMIN_NOM=Directeur Général
# SUPERADMIN_EMAIL=
# SUPERADMIN_PASSWORD=

# CORS : laisser vide (le site et l'API sont sur le même domaine).
# À remplir seulement si une AUTRE application doit appeler l'API, ex. :
# CORS_ORIGINS=https://app.exemple.com
